# Backend API origin (include /api prefix if your server mounts routes there)
# VITE_API_BASE_URL=http://localhost:5008/api
VITE_API_BASE_URL=https://afrimine-api.onrender.com/api/v1/

# Optional path overrides (no leading slash required)
# VITE_AUTH_LOGIN_PATH=auth/login
# VITE_AUTH_REGISTER_PATH=auth/register
# VITE_AUTH_REFRESH_PATH=auth/refresh-token
# VITE_AUTH_LOGOUT_PATH=auth/revoke
# VITE_AUTH_ME_PATH=auth/me
# VITE_AUTH_RESET_PASSWORD_PATH=auth/reset-password
